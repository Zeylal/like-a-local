---
interface Item {
  heading: string;
  body: string[];
}

interface Props {
  title: string;
  intro?: string[];
  items: Item[];
}

const { title, intro = [], items } = Astro.props;
---
<section class="booking-block">
  <div class="wrap">
    <h2>{title}</h2>
    {intro.map((p) => <p set:html={p} />)}
    <div class="accordion">
      {items.map((item, i) => (
        <details class="accordion__item" open={i === 0}>
          <summary>{item.heading}</summary>
          <div class="accordion__panel">
            {item.body.map((p) => <p set:html={p} />)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
